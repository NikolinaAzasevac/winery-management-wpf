<Window x:Class="Vinarija1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Vinarija1"
        mc:Ignorable="d"
        Title="Vinarija" Height="350" Width="700">
    <Grid>
        <StackPanel HorizontalAlignment="Center" Height="30" VerticalAlignment="Top" Width="auto" Orientation="Horizontal">
            <Button x:Name="btnProizvodjac" Content="Proizvođač" HorizontalAlignment="Left" VerticalAlignment="Top" Height="30" Width="75" Click="btnProizvodjac_Click"/>
            <Button x:Name="btnAmbalaza" Content="Ambalaža" HorizontalAlignment="Left" VerticalAlignment="Top" Height="30" Width="75" Click="btnAmbalaza_Click"/>
            <Button x:Name="btnVrstaVina" Content="Vrsta vina" HorizontalAlignment="Left" VerticalAlignment="Top" Height="30" Width="75" Click="btnVrstaVina_Click"/>
            <Button x:Name="btnKupac" Content="Kupac" HorizontalAlignment="Left" VerticalAlignment="Top" Height="30" Width="75" Click="btnKupac_Click"/>
            <Button x:Name="btnZaposleni" Content="Zaposleni" HorizontalAlignment="Left" VerticalAlignment="Top" Height="30" Width="75" Click="btnZaposleni_Click"/>
            <Button x:Name="btnVerifikator" Content="Verifikator" HorizontalAlignment="Left" VerticalAlignment="Top" Height="30" Width="75" Click="btnVerifikator_Click"/>
            <Button x:Name="btnVino" Content="Vino" HorizontalAlignment="Left" VerticalAlignment="Top" Height="30" Width="75" Click="btnVino_Click"/>
            <Button x:Name="btnPotvrdaOAutenticnosti" Content="Potvrda" HorizontalAlignment="Left" VerticalAlignment="Top" Height="30" Width="75" Click="btnPotvrdaOAutenticnosti_Click"/>
            <Button x:Name="btnRacun" Content="Račun" HorizontalAlignment="Left" VerticalAlignment="Top" Height="30" Width="75" Click="btnRacun_Click"/>
        </StackPanel>
    <StackPanel HorizontalAlignment="Center" Height="30" VerticalAlignment="Bottom" Width="auto" Orientation="Horizontal">
        <Button x:Name="btnDodaj" Content="Dodaj" Height="30" Width="120" Click="btnDodaj_Click"/>
        <Button x:Name="btnIzmeni" Content="Izmeni" Height="30" Width="120" Click="btnIzmeni_Click"/>
        <Button x:Name="btnObrisi" Content="Obriši" Height="30" Width="120" Click="btnObrisi_Click"/>

    </StackPanel>
        <DataGrid x:Name="dataGridCentralni" HorizontalAlignment="Center" Height="auto" VerticalAlignment="Center" Width="auto"
                  IsReadOnly="true" AlternatingRowBackground="Aqua" CanUserAddRows="False" SelectionUnit="FullRow"
                  SelectionMode="Single"/>
    </Grid>
</Window>
 