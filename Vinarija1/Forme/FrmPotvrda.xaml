<Window x:Class="Vinarija1.Forme.FrmPotvrda"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Vinarija1.Forme"
        mc:Ignorable="d"
        Title="Dodaj/izmeni potvrdu o autentičnosti" Height="300" Width="300">
    <Grid>
        <Label Content="Datum izdavanja:" HorizontalAlignment="Left" Margin="30,20,0,0" VerticalAlignment="Top"/>
        <Label Content="Vino:" HorizontalAlignment="Left" Margin="30,50,0,0" VerticalAlignment="Top"/>
        <Label Content="Verifikator:" HorizontalAlignment="Left" Margin="30,80,0,0" VerticalAlignment="Top"/>
        <DatePicker x:Name="dpDatum" HorizontalAlignment="Left" Height="24" Margin="130,20,0,0" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="txtCena" HorizontalAlignment="Left" Margin="130,50,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" Height="23"/>
        <ComboBox x:Name="cbxVino" HorizontalAlignment="Left" Margin="130,50,0,0" VerticalAlignment="Top" Width="120" DisplayMemberPath = "prikaz" SelectedValuePath = "VinoID"/>
        <ComboBox x:Name="cbxVerifikator" HorizontalAlignment="Left" Margin="130,80,0,0" VerticalAlignment="Top" Width="120" DisplayMemberPath = "prikaz" SelectedValuePath = "VerifikatorID"/>
        <Button x:Name="btnSacuvaj" Content="Sačuvaj" HorizontalAlignment="Left" Margin="50,240,0,0" VerticalAlignment="Top" Click="btnSacuvaj_Click"/>
        <Button x:Name="btnOtkazi" Content="Otkaži" HorizontalAlignment="Left" Margin="200,240,0,0" VerticalAlignment="Top" Click="btnOtkazi_Click"/>
    </Grid>
</Window>
