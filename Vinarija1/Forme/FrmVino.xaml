<Window x:Class="Vinarija1.Forme.FrmVino"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Vinarija1.Forme"
        mc:Ignorable="d"
        Title="Dodaj/izmeni vino" Height="300" Width="300">
    <Grid>
        <Label Content="Sorta:" HorizontalAlignment="Left" Margin="30,20,0,0" VerticalAlignment="Top"/>
        <Label Content="Berba:" HorizontalAlignment="Left" Margin="30,50,0,0" VerticalAlignment="Top"/>
        <Label Content="Region:" HorizontalAlignment="Left" Margin="30,80,0,0" VerticalAlignment="Top"/>
        <Label Content="Ambalaža:" HorizontalAlignment="Left" Margin="30,110,0,0" VerticalAlignment="Top"/>
        <Label Content="Proizvođač:" HorizontalAlignment="Left" Margin="30,140,0,0" VerticalAlignment="Top"/>
        <Label Content="Vrsta vina:" HorizontalAlignment="Left" Margin="30,170,0,0" VerticalAlignment="Top"/>
        <Label Content="Kupac:" HorizontalAlignment="Left" Margin="30,200,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtSorta" HorizontalAlignment="Left" Margin="130,20,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" Height="23"/>
        <TextBox x:Name="txtBerba" HorizontalAlignment="Left" Margin="130,50,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" Height="23"/>
        <TextBox x:Name="txtRegion" HorizontalAlignment="Left" Margin="130,80,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" Height="23"/>
        <ComboBox x:Name="cbxAmbalaza" HorizontalAlignment="Left" Margin="130,110,0,0" VerticalAlignment="Top" Width="120" SelectedValuePath = "ambalazaID" DisplayMemberPath = "ambalaza"/>
        <ComboBox x:Name="cbxProizvodjac" HorizontalAlignment="Left" Margin="130,140,0,0" VerticalAlignment="Top" Width="120" SelectedValuePath = "proizvodjacID" DisplayMemberPath = "imeProizvodjaca"/>
        <ComboBox x:Name="cbxVrstaVina" HorizontalAlignment="Left" Margin="130,170,0,0" VerticalAlignment="Top" Width="120" SelectedValuePath = "vrstaVinaID" DisplayMemberPath = "vrsta"/>
        <ComboBox x:Name="cbxKupac" HorizontalAlignment="Left" Margin="130,200,0,0" VerticalAlignment="Top" Width="120" SelectedValuePath = "kupacID" DisplayMemberPath = "kupac"/>
        <Button x:Name="btnSacuvaj" Content="Sačuvaj" HorizontalAlignment="Left" Margin="50,240,0,0" VerticalAlignment="Top" Click="btnSacuvaj_Click"/>
        <Button x:Name="btnOtkazi" Content="Otkaži" HorizontalAlignment="Left" Margin="200,240,0,0" VerticalAlignment="Top" Click="btnOtkazi_Click"/>
    </Grid>
</Window>
